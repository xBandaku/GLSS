# mod_glss_uni_functions
!! GLSS university automation: graded core (lectures + exams). See mod_glss
!! for how these get triggered. Electives are handled separately in
!! mod_glss_uni_electives_functions - they carry no grade weight in the real
!! game, so they are gated behind their own toggle.
!!
!! Design mirrors the school day_grades function in mod_glss_functions: these are silent
!! credit calls only, never visiting the real uni_lessons/uni_exams screens,
!! so ghost mode is safe to run from the dispatcher. Every attend_class /
!! class_activity_attributes call replicates the exact institution/subject/
!! stat the matching handler in uni_lessons1-4.qsrc makes - including a
!! handful of upstream teaching_studies bugs (wrong subject string on some
!! "ask a question" calls, pcs_intel used twice instead of pcs_intel then
!! pcs_chrsm). Participation selects which of those grade calls run.
!! Nursing has no such bugs. Semesters 5-8 have no lecture data in the base
!! game, so the lookups below simply resolve nothing for them.
!!
!! Both credit_period and credit_exam reuse uni_period[...], the same flag
!! the vanilla game uses to track attendance for the day - so crediting a period
!! here also stops the vanilla "Go to your X class" action from re-offering
!! it, and a period the player already attended manually is never re-credited.

!! ---------------------------------------------------------------------
!! credit_period
!! Silently credits one lecture period for today (ARGS[1] = 'first'/
!! 'second'/'third') if a real, non-elective lecture exists for the current
!! program/semester/weekday/period and it has not already been credited
!! today. Third period only ever resolves on Wednesday (week = 3) - the
!! Monday/Tuesday/Thursday third-period slots are elective-only.
!! ---------------------------------------------------------------------
if $ARGS[0] = 'credit_period':
	if uni_period[$ARGS[1]] = daystart: exit
	if university['enrolled_in_semester'] < 1 or university['enrolled_in_semester'] > 4: exit
	if week < 1 or week > 4: exit

	glss_sem = university['enrolled_in_semester']
	$glss_us = $func('mod_glss_uni_functions', 'field', $func('mod_glss_uni_functions', 'row', '<<$university[''enrolled_in'']>>_<<glss_sem>>_<<$ARGS[1]>>'), week)

	if $glss_us ! '':
		uni_period[$ARGS[1]] = daystart
		$glss_ui = 'uni_<<$university[''enrolled_in'']>>_semester_<<glss_sem>>'

		!! Second class_activity_attributes call: standard is (same subject,
		!! charisma), mirroring the real "ask a question" bonus. A set of
		!! teaching_studies subjects have an upstream bug where that bonus
		!! re-uses pcs_intel instead of pcs_chrsm; two of those also use the
		!! wrong subject string. Replicated verbatim - see file header.
		$glss_us2 = $glss_us
		glss_stat2 = pcs_chrsm
		if $university['enrolled_in'] = 'teaching_studies':
			if $glss_us = 'teaching methods 102':
				$glss_us2 = 'teaching methods'
				glss_stat2 = pcs_intel
			elseif $glss_us = 'learning theories 202':
				$glss_us2 = 'assessment 202'
				glss_stat2 = pcs_intel
			elseif $glss_us = 'teaching methods 101' or $glss_us = 'learning theories 101' or $glss_us = 'psychology of a student 101' or $glss_us = 'assessment 201' or $glss_us = 'learning theories 201' or $glss_us = 'psychology of a student 201':
				glss_stat2 = pcs_intel
			end
		end

		gs 'grades', 'attend_class', $glss_ui, $glss_us
		if glss['uni_participation'] ! 2:
			if func('mod_glss_functions', 'pay_attention'):
				gs 'grades', 'class_activity_attributes', $glss_ui, $glss_us, pcs_intel
				if glss['uni_participation'] = 1: gs 'grades', 'class_activity_attributes', $glss_ui, $glss_us2, glss_stat2
			end
		end
	end

	killvar '$glss_us'
	killvar '$glss_us2'
	killvar '$glss_ui'
	killvar 'glss_sem'
	killvar 'glss_stat2'
	exit
end


!! ---------------------------------------------------------------------
!! credit_exam
!! Silently completes the exam due today, if any (mirrors the trigger
!! conditions in uni_programs set_exam_act_nursing/set_exam_act_teaching
!! exactly) and it has not already been completed today. The grade itself was
!! already accumulated via calculate_grade during the semester; this only
!! sets the "_exam_done" flag the semester-end pass/fail loop checks, which
!! is what actually prevents expulsion for a missed exam.
!! ---------------------------------------------------------------------
if $ARGS[0] = 'credit_exam':
	if uni_period['exam'] = daystart: exit
	if university['exam_week'] < 1 or university['exam_week'] > 2: exit
	if university['enrolled_in_semester'] < 1 or university['enrolled_in_semester'] > 4: exit
	if week < 1 or week > 4: exit

	glss_sem = university['enrolled_in_semester']
	$glss_us = $func('mod_glss_uni_functions', 'field', $func('mod_glss_uni_functions', 'row', '<<$university[''enrolled_in'']>>_<<glss_sem>>_exam'), (university['exam_week'] - 1) * 4 + week)

	if $glss_us ! '':
		uni_period['exam'] = daystart
		$glss_ui = 'uni_<<$university[''enrolled_in'']>>_semester_<<glss_sem>>'
		class['<<$glss_ui>>_<<$glss_us>>_exam_done'] = 1
		gs 'grades', 'assign_grade_description', $glss_ui
	end

	killvar '$glss_us'
	killvar '$glss_ui'
	killvar 'glss_sem'
	exit
end


!! ---------------------------------------------------------------------
!! row
!! The lecture and exam timetable, copied from uni_programs
!! set_*_period_act_* and set_exam_act_*. ARGS[1] is
!! '<program>_<semester>_<first|second|third|exam>'. Lecture rows hold one
!! '|' separated subject per weekday, Monday to Thursday; an empty field
!! means no graded lecture in that slot (Monday/Tuesday/Thursday third
!! periods are elective-only). Exam rows hold exam week 1 Monday-Thursday
!! followed by exam week 2 Monday-Thursday. Semesters 5-8 have no rows.
!! ---------------------------------------------------------------------
if $ARGS[0] = 'row':
	if $ARGS[1] = 'nursing_1_first': $result = 'patient care 101|anatomy and physiology 101|examination and treatment 101|patient care 101'
	if $ARGS[1] = 'nursing_2_first': $result = 'patient care 102|anatomy and physiology 102|examination and treatment 102|patient care 102'
	if $ARGS[1] = 'nursing_3_first': $result = 'patient care 201|anatomy and physiology 201|dosages and pharmaceuticals 101|patient care 201'
	if $ARGS[1] = 'nursing_4_first': $result = 'patient care 202|anatomy and physiology 202|dosages and pharmaceuticals 102|patient care 202'
	if $ARGS[1] = 'nursing_1_second': $result = 'anatomy and physiology 101|patient care 101|patient care 101|anatomy and physiology 101'
	if $ARGS[1] = 'nursing_2_second': $result = 'anatomy and physiology 102|patient care 102|patient care 102|anatomy and physiology 102'
	if $ARGS[1] = 'nursing_3_second': $result = 'anatomy and physiology 201|patient care 201|patient care 201|anatomy and physiology 201'
	if $ARGS[1] = 'nursing_4_second': $result = 'anatomy and physiology 202|patient care 202|patient care 202|anatomy and physiology 202'
	if $ARGS[1] = 'nursing_1_third': $result = '||anatomy and physiology 101|'
	if $ARGS[1] = 'nursing_2_third': $result = '||anatomy and physiology 102|'
	if $ARGS[1] = 'nursing_3_third': $result = '||anatomy and physiology 201|'
	if $ARGS[1] = 'nursing_4_third': $result = '||anatomy and physiology 202|'
	if $ARGS[1] = 'nursing_1_exam': $result = '|||patient care 101||anatomy and physiology 101||examination and treatment 101'
	if $ARGS[1] = 'nursing_2_exam': $result = '|||patient care 102||anatomy and physiology 102||examination and treatment 102'
	if $ARGS[1] = 'nursing_3_exam': $result = '|||patient care 201||anatomy and physiology 201||dosages and pharmaceuticals 101'
	if $ARGS[1] = 'nursing_4_exam': $result = '|||patient care 202||anatomy and physiology 202||dosages and pharmaceuticals 102'
	if $ARGS[1] = 'teaching_studies_1_first': $result = 'general education 101|general education 101|general education 101|teaching methods 101'
	if $ARGS[1] = 'teaching_studies_2_first': $result = 'general education 102|general education 102|general education 102|teaching methods 102'
	if $ARGS[1] = 'teaching_studies_3_first': $result = 'general education 201|general education 201|general education 201|assessment 201'
	if $ARGS[1] = 'teaching_studies_4_first': $result = 'general education 202|general education 202|general education 202|learning theories 202'
	if $ARGS[1] = 'teaching_studies_1_second': $result = 'teaching methods 101|learning theories 101|teaching methods 101|learning theories 101'
	if $ARGS[1] = 'teaching_studies_2_second': $result = 'teaching methods 102|psychology of a student 101|teaching methods 102|psychology of a student 101'
	if $ARGS[1] = 'teaching_studies_3_second': $result = 'assessment 201|learning theories 201|assessment 201|learning theories 201'
	if $ARGS[1] = 'teaching_studies_4_second': $result = 'learning theories 202|psychology of a student 201|learning theories 202|psychology of a student 201'
	if $ARGS[1] = 'teaching_studies_1_third': $result = '||learning theories 101|'
	if $ARGS[1] = 'teaching_studies_2_third': $result = '||psychology of a student 101|'
	if $ARGS[1] = 'teaching_studies_3_third': $result = '||learning theories 201|'
	if $ARGS[1] = 'teaching_studies_4_third': $result = '||psychology of a student 201|'
	if $ARGS[1] = 'teaching_studies_1_exam': $result = '|||general education 101||teaching methods 101||learning theories 101'
	if $ARGS[1] = 'teaching_studies_2_exam': $result = '|||general education 102||teaching methods 102||psychology of a student 101'
	if $ARGS[1] = 'teaching_studies_3_exam': $result = '|||general education 201||assessment 201||learning theories 201'
	if $ARGS[1] = 'teaching_studies_4_exam': $result = '|||general education 202||learning theories 202||psychology of a student 201'
	exit
end


!! ---------------------------------------------------------------------
!! field
!! $result = field number ARGS[2] (counting from 1) of the '|' separated
!! string ARGS[1], or '' when there is no such field.
!! ---------------------------------------------------------------------
if $ARGS[0] = 'field':
	$glss_rest = $ARGS[1] + '|'
	glss_n = ARGS[2]
	:glss_field_loop
	glss_pos = instr($glss_rest, '|')
	if glss_n > 1 and glss_pos > 0: $glss_rest = $mid($glss_rest, glss_pos + 1) & glss_n -= 1 & jump 'glss_field_loop'
	if glss_n = 1 and glss_pos > 0: $result = $mid($glss_rest, 1, glss_pos - 1)
	killvar '$glss_rest'
	killvar 'glss_n'
	killvar 'glss_pos'
	exit
end


!! ---------------------------------------------------------------------
!! ghost_credit
!! Background credit for the lectures and exam that have started today,
!! wherever the player is. Runs from the dispatcher (from 9:00), so it must
!! not print or change the screen. Zero time cost, same as the school
!! ghost_credit. A period is only credited once its class has started
!! (9:00, 11:00, 13:15), so a later lecture stays available in person until
!! then; credit_period skips a period the player already attended.
!! ---------------------------------------------------------------------
if $ARGS[0] = 'ghost_credit':
	glss_third_started = 0
	if hour > 13 or (hour = 13 and minut >= 15): glss_third_started = 1
	if university['semester_week'] > 0:
		gs 'mod_glss_uni_functions', 'credit_period', 'first'
		if hour >= 11: gs 'mod_glss_uni_functions', 'credit_period', 'second'
		if glss_third_started = 1: gs 'mod_glss_uni_functions', 'credit_period', 'third'
	end
	if university['exam_week'] > 0: gs 'mod_glss_uni_functions', 'credit_exam'
	if glss['uni_electives'] = 1 and glss_third_started = 1: gs 'mod_glss_uni_electives_functions', 'ghost_credit'
	killvar 'glss_third_started'
	exit
end


!! ---------------------------------------------------------------------
!! lesson_end
!! Moves the clock from the start of a lecture to its end. Every real
!! lecture and elective ends in uni_lessons 'short_break', whose time
!! rules take 9:00 to 10:30, 11:00 to 12:30 and 13:15 to 14:45.
!! ---------------------------------------------------------------------
if $ARGS[0] = 'lesson_end':
	if hour = 9: minut += 90 - minut
	if hour = 11: minut += 90 - minut
	if hour = 13: minut += 105 - minut
	gs 'time'
	exit
end


!! ---------------------------------------------------------------------
!! auto_uni_day
!! One-click university day, started from the campus/hallway action
!! injected by mod_glss. Credits whichever lecture periods and exam are
!! still due today and advances the clock using the same per-period
!! formulas the real class actions use (including the nursing-semester-4
!! second-period exception), landing at a realistic end-of-day time
!! instead of a single hardcoded jump. A period stops being due once its
!! class has started (9:00, 11:00, 13:15; exams 9:00), the same cut-offs
!! uni_lessons 'compute_stat_display' uses, so a late click only covers
!! the rest of the day.
!! ---------------------------------------------------------------------
if $ARGS[0] = 'auto_uni_day':
	*clr & cla
	$menu_loc = 'uni_grounds'
	$menu_arg = 'main'
	$location_type = 'public_outdoors'
	menu_off = 0

	glss_did_something = 0

	if university['semester_week'] > 0:
		if uni_period['first'] ! daystart and hour < 9:
			minut += max(0, (9 - hour)*60 - minut)
			gs 'time'
			gs 'mod_glss_uni_functions', 'credit_period', 'first'
			if uni_period['first'] = daystart:
				glss_did_something = 1
				gs 'mod_glss_uni_functions', 'lesson_end'
			end
		end
		if uni_period['second'] ! daystart and hour < 11:
			!! The gs time calls surrounding this block keep hour normalized,
			!! so this literal check behaves the same as it does in vanilla play.
			if $university['enrolled_in'] = 'nursing' and university['enrolled_in_semester'] = 4:
				if hour = 10: minut += 60 - minut
			else
				minut += max(0, (11 - hour)*60 - minut)
			end
			gs 'time'
			gs 'mod_glss_uni_functions', 'credit_period', 'second'
			if uni_period['second'] = daystart:
				glss_did_something = 1
				gs 'mod_glss_uni_functions', 'lesson_end'
			end
		end
		if uni_period['third'] ! daystart and week = 3 and (hour < 13 or (hour = 13 and minut < 15)):
			minut += max(0, (13 - hour) * 60 + (15 - minut))
			gs 'time'
			gs 'mod_glss_uni_functions', 'credit_period', 'third'
			if uni_period['third'] = daystart:
				glss_did_something = 1
				gs 'mod_glss_uni_functions', 'lesson_end'
			end
		end
	end
	if university['exam_week'] > 0 and uni_period['exam'] ! daystart and hour < 9:
		minut += max(0, (9 - hour)*60 - minut)
		gs 'time'
		gs 'mod_glss_uni_functions', 'credit_exam'
		if uni_period['exam'] = daystart:
			minut += 180
			gs 'time'
			glss_did_something = 1
		end
	end
	if glss['uni_electives'] = 1 and uni_period['third'] ! daystart:
		gs 'mod_glss_uni_electives_functions', 'auto_day'
		if uni_period['third'] = daystart: glss_did_something = 1
	end

	gs 'stat'
	$func('wrap', 'header center b', 'University')
	'<center><img <<$set_imgh>> src="images/locations/city/island/university/uni_day.jpg"></center>'
	if glss_did_something = 1:
		'You put your head down and let the rest of your university day carry you along: lectures and campus chatter blur together until you find yourself back on the quad.'
	else
		'There was nothing left on your schedule for today.'
	end
	killvar 'glss_did_something'

	act 'Head back to the university plaza': gt 'uni_grounds'
	exit
end

if $ARGS[0] = 'has_class_action':
	!! 5.7 preserves action code case; newer players uppercase it.
	$glss_acts = $ucase($curacts)
	glss_act_i = 1
	:glss_class_action_loop
	if instr($glss_acts, 'GT ''UNI_LESSONS<<glss_act_i>>'',') > 0 or instr($glss_acts, 'GT ''UNI_EXAMS<<glss_act_i>>'',') > 0: result = 1
	glss_act_i += 1
	if glss_act_i <= 4: jump 'glss_class_action_loop'
	if glss['uni_electives'] = 1 and instr($glss_acts, 'GT ''UNI_LESSONS_ELECTIVES'',') > 0: result = 1
	killvar '$glss_acts'
	killvar 'glss_act_i'
	exit
end

--- mod_glss_uni_functions ---------------------------------
