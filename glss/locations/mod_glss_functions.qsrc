# mod_glss_functions
!! GLSS school automation. See mod_glss for how these get triggered.

!! ---------------------------------------------------------------------
!! ghost_credit
!! Background credit for a full school day. Mirrors the attendance
!! bookkeeping at the top of gschool_lessons 'morning'. Runs silently
!! from the dispatcher, so it must not print or change the screen.
!! Deliberately skipped: gschool_socialchg (interactive school social
!! life) and the uniform check - Sveta was never really there.
!! ---------------------------------------------------------------------
if $ARGS[0] = 'ghost_credit':
	gschoolVars['last_attendance'] = daystart
	gschoolVars['absence_count'] -= 1
	school_lunch = 0
	if missing_class > 9:
		missing_class -= 9
	elseif missing_class > 6:
		missing_class -= 6
	end
	lernSkill += 1
	lernHome += 1
	gs 'mod_glss_functions', 'day_grades', 0
	exit
end


!! ---------------------------------------------------------------------
!! auto_lunch
!! Smart lunch policy for automated school days, mirroring the choices
!! in gschool_lunch 'cafeteria': bagged lunch from home when living at
!! the parents home, otherwise buy cafeteria food (50 RUB) when she
!! can afford it, otherwise go hungry. Uses the silent _stats food
!! handlers so it is safe to run from the dispatcher. Reports what
!! happened in glss_temp_lunch (0 = nothing, 1 = bagged, 2 = bought);
!! the caller owns killvar of that variable.
!! ---------------------------------------------------------------------
if $ARGS[0] = 'auto_lunch':
	glss_temp_lunch = 0
	if glss['lunch_day'] = daystart + 1:
		glss_temp_lunch = 3
		exit
	end
	if glss['auto_lunch'] = 1:
		if func('homes_properties', 'has_access', 'parents_home'):
			gs 'food', 'bagged_lunch_stats'
			glss_temp_lunch = 1
		elseif func('money', 'can_afford', 50) = 1:
			gs 'money', 'pay', 50
			gs 'food', 'medium_meal_stats'
			glss_temp_lunch = 2
		end
	end
	if glss_temp_lunch > 0: glss['lunch_day'] = daystart + 1
	exit
end


!! ---------------------------------------------------------------------
!! auto_day
!! One-click school day, started from the hallway action injected by
!! mod_glss. Attendance was already credited when 'morning' ran; this
!! credits the remaining lessons and moves the clock to the end of the
!! school day (14:00). Time-based needs (hunger, energy, etc.) are
!! drained by the normal stat processing of the elapsed time.
!! ---------------------------------------------------------------------
if $ARGS[0] = 'auto_day':
	*clr & cla
	$menu_loc = 'gschool_lessons'
	$menu_arg = 'short_break'
	$location_type = 'public_indoors'
	menu_off = 0
	killvar 'breaktype'

	gs 'mod_glss_functions', 'day_grades', school_period

	!! Lunch is period 5; only auto-eat if it is still ahead of us.
	glss_temp_lunch = -1
	if school_period <= 5: gs 'mod_glss_functions', 'auto_lunch'

	if hour*60 + minut < 14*60: minut += 14*60 - (hour*60 + minut)
	school_period = 0
	gs 'stat'

	$func('wrap', 'header center b', 'School')
	'<center><img <<$set_imgh>> src="images/locations/pavlovsk/school/building/gschool_hall0<<rand(0,2)>>.jpg"></center>'
	'You put your head down and let the school day carry you along: lessons, breaks and hallway chatter blur together until the final bell rings.'
	if glss_temp_lunch = 1:
		'<i>You ate the bagged lunch from home during the midday break.</i>'
	elseif glss_temp_lunch = 2:
		'<i>You bought lunch at the cafeteria for <<$func(''money'', ''string_price'', 50)>> during the midday break.</i>'
	elseif glss_temp_lunch = 0:
		'<i>You didn''t stop for lunch, so grab something to eat if you''re hungry.</i>'
	elseif glss_temp_lunch = 3:
		'<i>GLSS already provided lunch today.</i>'
	end
	killvar 'glss_temp_lunch'

	act 'Head out to the school grounds': gt 'gschool_grounds', 'main'
	exit
end


!! ---------------------------------------------------------------------
!! day_grades
!! Grade credit for the current day of lessons from period ARGS[1] onwards.
!! The subject table matches the real lesson dispatcher in
!! gschool_lessons 'schedule' (periods 2 and 5 are breaks). Each class
!! gets attendance and the selected participation bonuses.
!! Runs at most once per game day.
!! ---------------------------------------------------------------------
if $ARGS[0] = 'day_grades':
	if glss['grades_day'] = daystart: exit
	glss['grades_day'] = daystart
	glss['school_credit_day'] = daystart
	killvar 'glss_school_gain'
	killvar 'glss_school_after'
	killvar 'glss_school_cost'
	killvar '$glss_school_subject'

	if week = 1:
		$glss_subj[0] = 'math' & $glss_subj[1] = 'rus' & $glss_subj[3] = 'eng' & $glss_subj[4] = 'art' & $glss_subj[6] = 'bio' & $glss_subj[7] = 'pe'
	elseif week = 2 or week = 4:
		$glss_subj[0] = 'lit' & $glss_subj[1] = 'geo' & $glss_subj[3] = 'sci' & $glss_subj[4] = 'shop' & $glss_subj[6] = 'comp' & $glss_subj[7] = 'mus'
	elseif week = 3:
		$glss_subj[0] = 'math' & $glss_subj[1] = 'rus' & $glss_subj[3] = 'bio' & $glss_subj[4] = 'his' & $glss_subj[6] = 'comp' & $glss_subj[7] = 'pe'
	elseif week = 5:
		$glss_subj[0] = 'math' & $glss_subj[1] = 'rus' & $glss_subj[3] = 'eng' & $glss_subj[4] = 'art' & $glss_subj[6] = 'his' & $glss_subj[7] = 'pe'
	end

	glss_i = ARGS[1]
	:glss_subj_loop
	if $glss_subj[glss_i] ! '':
		$glss_school_subject[] = $glss_subj[glss_i]
		glss_grade_before = class['school_<<$glss_subj[glss_i]>>_weekly_grade_gain']
		glss_will_before = pcs_willpwr
		gs 'grades', 'attend_class', 'school', $glss_subj[glss_i]
		gs 'mod_glss_functions', 'school_activity', $glss_subj[glss_i]
		glss_school_after[$glss_subj[glss_i]] = class['school_<<$glss_subj[glss_i]>>_weekly_grade_gain']
		glss_school_gain[$glss_subj[glss_i]] = glss_school_after[$glss_subj[glss_i]] - glss_grade_before
		glss_school_cost[$glss_subj[glss_i]] = glss_will_before - pcs_willpwr
	end
	glss_i += 1
	if glss_i < 8: jump 'glss_subj_loop'

	killvar 'glss_i'
	killvar 'glss_subj'
	killvar 'glss_grade_before'
	killvar 'glss_will_before'
	exit
end

if $ARGS[0] = 'pay_attention':
	!! A silent hook must not change costs prepared by the current scene.
	glss_attention_saved_cost = will_cost
	gs 'willpower', 'chore', 'self', iif(grupTipe = 4 and trait_vars['academic'] = 0, 'hard', iif(trait_vars['academic'] > 0, 'easy', 'medium'))
	if trait_vars['academic'] = 2:
		will_cost = will_cost / 2
	elseif trait_vars['academic'] >= 3:
		will_cost = 0
	end
	if pcs_willpwr >= will_cost:
		if will_cost > 0: gs 'willpower', 'pay', 'self', 'chore'
		result = 1
	end
	will_cost = glss_attention_saved_cost
	killvar 'glss_attention_saved_cost'
	exit
end

if $ARGS[0] = 'school_activity':
	!! PE has no listening branch; exercise and its rewards remain manual.
	if glss['school_participation'] = 2 or $ARGS[1] = 'pe': exit
	if func('mod_glss_functions', 'pay_attention') = 0: exit
	gs 'grades', 'class_activity_attributes', 'school', $ARGS[1], pcs_intel
	if glss['school_participation'] ! 1: exit
	if $ARGS[1] = 'comp':
		gs 'grades', 'class_activity_skill', 'school', 'comp', pcs_compskl
	elseif $ARGS[1] = 'mus':
		gs 'grades', 'class_activity_skill', 'school', 'mus', max(pcs_vokal, pcs_instrmusic)
	elseif $ARGS[1] = 'art':
		gs 'grades', 'class_activity_skill', 'school', 'art', pcs_artskls
	elseif $ARGS[1] = 'shop':
		gs 'grades', 'class_activity_skill', 'school', 'shop', pcs_hndiwrk
	elseif $ARGS[1] = 'lit':
		gs 'grades', 'class_activity_attributes', 'school', 'lit', pcs_prcptn
	elseif $ARGS[1] = 'rus' or $ARGS[1] = 'eng':
		gs 'grades', 'class_activity_attributes', 'school', $ARGS[1], pcs_chrsm
	else
		gs 'grades', 'class_activity_attributes', 'school', $ARGS[1], pcs_intel
	end
	exit
end

if $ARGS[0] = 'reconcile_grades':
	if glss['school_credit_day'] ! daystart: exit
	glss_check_i = 0
	:glss_credit_loop
	if glss_check_i < arrsize('$glss_school_subject'):
		$glss_check_subject = $glss_school_subject[glss_check_i]
		!! Only classroom code adds to this counter during a day. Homework
		!! uses optional_weekly_grade_gain, so it does not replace attendance.
		if glss_school_gain[$glss_check_subject] > 0 and class['school_<<$glss_check_subject>>_weekly_grade_gain'] > glss_school_after[$glss_check_subject]:
			class['school_<<$glss_check_subject>>_weekly_grade_gain'] -= glss_school_gain[$glss_check_subject]
			pcs_willpwr = min(willpowermax, pcs_willpwr + glss_school_cost[$glss_check_subject])
			glss_school_gain[$glss_check_subject] = 0
			glss_school_cost[$glss_check_subject] = 0
		end
		glss_check_i += 1
		jump 'glss_credit_loop'
	end
	killvar 'glss_check_i'
	killvar '$glss_check_subject'
	exit
end

--- mod_glss_functions ---------------------------------
