# mod_glss
!! GLSS main dispatcher.
!! mod_system calls this location on every location change (via LOCA) and
!! from the sleep trigger hooks. It must remain silent because it runs
!! after the destination has prepared its screen and actions.

gs 'mod_glss_functions', 'reconcile_grades'
glss_saved_will_cost = will_cost

if glss['ghost_school'] = 1 or glss['auto_school'] = 1:
	!! Shared gate: schoolgirl start, still enrolled, not expelled, term time, school day.
	if $start_type['loc'] = 'sg' and gschoolVars['school_diploma'] = 0 and gschoolVars['block'] = 0 and kanikuli = 0 and week < 6:
		!! -------------------------------------------------------------
		!! Ghost attendance
		!! Once the school day has started (8:00), silently credit
		!! attendance and average grades for today, wherever the player
		!! is. Mirrors the credit block at the top of gschool_lessons
		!! 'morning'. The hourly absence tick in hourly_events adds +1
		!! every school day and real attendance takes it back with -1;
		!! the ghost credit does the same, so absences net to zero.
		!! -------------------------------------------------------------
		if glss['ghost_school'] = 1 and hour >= 8 and gschoolVars['last_attendance'] ! daystart and glss['ghost_day'] ! daystart:
			glss['ghost_day'] = daystart
			gs 'mod_glss_functions', 'ghost_credit'
		end
		if glss['ghost_school'] = 1 and glss['ghost_day'] = daystart and hour >= 12 and hour < 14:
			gs 'mod_glss_functions', 'auto_lunch'
			killvar 'glss_temp_lunch'
		end

		!! -------------------------------------------------------------
		!! One-click school day
		!! Appends an action to the school hallway screens. Gated on the
		!! regular hallway actions being present, so special morning
		!! scenes (principal summons, grade check, game night invite,
		!! cheerleading) are never bypassed.
		!! -------------------------------------------------------------
		if glss['auto_school'] = 1 and $curloc = 'gschool_lessons' and hour < 14:
			if instr($curacts, 'Go to first period') > 0:
				!! Morning hallway: start from period 0, like the vanilla 'Go to first period' action does.
				act 'GLSS: Attend the whole school day automatically': school_period = 0 & gt 'mod_glss_functions', 'auto_day'
			elseif instr($curacts, 'Go to next class') > 0:
				act 'GLSS: Attend the rest of the school day automatically': gt 'mod_glss_functions', 'auto_day'
			end
		end
	end
end

if glss['ghost_uni'] = 1 or glss['auto_uni'] = 1:
	!! Shared gate: currently enrolled, semester in progress, weekday. Mirrors
	!! the exact condition uni_grounds itself uses to decide whether to offer
	!! any class/exam action at all.
	if university['student'] = 1 and university['enrolled_in_semester'] > university['semester_passed'] and week < 5:
		!! -------------------------------------------------------------
		!! Ghost attendance
		!! Once the day has started, silently credit whatever lectures
		!! and exam are due today, wherever the player is. Also silently
		!! completes electives when that toggle is on. Exam completion
		!! prevents missing-exam failures; passing still requires grades > 40.
		!! -------------------------------------------------------------
		if glss['ghost_uni'] = 1 and hour >= 9 and glss['ghost_uni_day'] ! daystart:
			glss['ghost_uni_day'] = daystart
			gs 'mod_glss_uni_functions', 'ghost_credit'
		end

		!! -------------------------------------------------------------
		!! One-click university day
		!! Appends an action to the campus/lecture-hall screens. Gated on
		!! a real class or exam action being present, so campus random
		!! events and interactive NPC hooks (Niko, Katja, nerd_game_night)
		!! are never bypassed. Inspect destinations rather than label prefixes.
		!! -------------------------------------------------------------
		if glss['auto_uni'] = 1 and ($curloc = 'uni_grounds' or $curloc = 'uni_lessons'):
			if func('mod_glss_uni_functions', 'has_class_action'):
				act 'GLSS: Attend the rest of your university day automatically': gt 'mod_glss_uni_functions', 'auto_uni_day'
			end
		end
	end
end

will_cost = glss_saved_will_cost
killvar 'glss_saved_will_cost'

--- mod_glss ---------------------------------
